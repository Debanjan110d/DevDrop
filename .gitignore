# ==============================================================================
# DevDrop Monorepo .gitignore
# Open-Source Local File & Clipboard Sharing Platform
# ==============================================================================

# Node Dependencies
node_modules/
.pnp/
.pnp.js

# Logs
/logs/
/Logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*

# TypeScript Build Info
*.tsbuildinfo

# Build Outputs (Exclude generated dist except static release assets)
/dist/
build/
out/
apps/server/dist/
apps/web/dist/
apps/extension/dist/
packages/*/dist/

# Android Native & Gradle Build Artifacts
apps/android/android/.gradle/
apps/android/android/app/build/
apps/android/android/build/
apps/android/android/.idea/
apps/android/android/*.iml
apps/android/android/app/*.iml
apps/android/android/local.properties
apps/android/android/captures/
apps/android/android/.cxx/
apps/android/android/app/.cxx/
apps/android/.expo/
.expo/
*.apk.idsig
*.aab

# Local Development SDKs & Tools (Preserve tools/native-host)
tools/android-sdk/
tools/jdk-*/
tools/*.zip
tools/*.tar.gz
tools/*.exe

# DevDrop Runtime File Storage & Local Databases (Anchored to root)
/Files/
/Database/
/DevDrop/
*.sqlite
*.sqlite-journal
*.sqlite3
*.db
*.tmp

# Environment Variables & Credentials
.env
.env.local
.env.*.local
*.keystore
!debug.keystore
*.jks

# OS Generated Files
.DS_Store
.DS_Store?
._*
.Spotlight-V8
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# IDEs & Code Editors
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Testing & Temporary Directories
coverage/
.nyc_output/
/tmp/
/temp/
/scratch/
