{
  "manifest_version": 3,
  "name": "DevDrop",
  "version": "1.0.0",
  "description": "Your devices. Your network. Your files. Quick access to DevDrop local sharing.",
  "key": "",
  "permissions": [
    "storage",
    "alarms",
    "contextMenus",
    "notifications",
    "nativeMessaging"
  ],
  "host_permissions": [
    "http://localhost/*",
    "http://127.0.0.1/*",
    "http://*/*"
  ],
  "action": {
    "default_popup": "src/popup/index.html",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  }
}
