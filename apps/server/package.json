{
  "name": "@devdrop/server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "DevDrop Express server – LAN file sharing backend",
  "main": "dist/index.js",
  "scripts": {
    "dev": "nodemon --exec tsx src/index.ts",
